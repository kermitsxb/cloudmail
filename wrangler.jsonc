{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudmail",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Sous-domaine sur lequel Cloudmail est exposé (voir la section « Mise en service »
  // du README). Ce domaine doit être géré sur le compte Cloudflare qui héberge le Worker.
  "routes": [{ "pattern": "mail.planigramme.fr", "custom_domain": true }],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudmail",
      // Identifiant de la base D1 distante (créée à l'étape 1 de la section « Mise en
      // service » du README). En local, `wrangler dev` et les tests Vitest n'utilisent pas
      // cette valeur : Miniflare simule D1 et R2 sans authentification Cloudflare.
      "database_id": "8fb20c02-9769-4c20-982c-2917b5d678f9",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MAIL", "bucket_name": "cloudmail" }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ALLOWED_EMAILS": "",
    // Domaine utilisé pour générer le Message-ID des emails envoyés (voir
    // src/api/routes.ts). Doit correspondre au domaine géré à l'étape 5 de la
    // section « Mise en service » du README (Email Service / Sending).
    "MAIL_DOMAIN": "planigramme.fr"
  }
}
