{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudmail",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Remplacer "mail.example.com" par le sous-domaine sur lequel Cloudmail doit être
  // exposé (voir la section « Mise en service » du README). Ce domaine doit être géré
  // sur le compte Cloudflare qui héberge le Worker.
  "routes": [{ "pattern": "mail.example.com", "custom_domain": true }],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudmail",
      // Placeholder : à remplacer par l'identifiant réel de la base D1 distante lors de la
      // mise en service (voir la section « Mise en service » du README, étape 1). En
      // attendant, "local" suffit : Miniflare fournit D1 et R2 en local pour `wrangler dev`
      // et les tests Vitest, sans authentification Cloudflare.
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MAIL", "bucket_name": "cloudmail" }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ALLOWED_EMAILS": "",
    // Domaine utilisé pour générer le Message-ID des emails envoyés (voir
    // src/api/routes.ts). Doit correspondre au domaine géré à l'étape 5 de la
    // section « Mise en service » du README (Email Service / Sending).
    "MAIL_DOMAIN": "example.com"
  }
}
