{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudmail",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Placeholder. Le sous-domaine réel n'est PAS versionné : il vit dans
  // wrangler.overrides.json (ignoré par git), appliqué au déploiement par
  // scripts/config.mjs. Voir « Ne jamais versionner de valeur propre à votre
  // installation » dans le README.
  "routes": [{ "pattern": "mail.example.com", "custom_domain": true }],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudmail",
      // Placeholder : "local" suffit en développement, où Miniflare simule D1 et R2
      // sans authentification Cloudflare — c'est ce qui permet à `pnpm test` et
      // `pnpm dev` de fonctionner sur un clone neuf sans préparation. L'identifiant
      // réel de la base distante vit dans wrangler.overrides.json (ignoré par git).
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MAIL", "bucket_name": "cloudmail" }
  ],
  "vars": {
    // ACCESS_TEAM_DOMAIN, ACCESS_AUD et ALLOWED_EMAILS sont délibérément absents
    // de ce fichier : ce sont des valeurs propres à une installation, et ce dépôt
    // est destiné à être cloné et réutilisé. Elles se posent en secrets, qui ne
    // transitent jamais par git :
    //   pnpm wrangler secret put ACCESS_TEAM_DOMAIN
    //   pnpm wrangler secret put ACCESS_AUD
    //   pnpm wrangler secret put ALLOWED_EMAILS
    // En développement local, .dev.vars (ignoré par git) les fournit. Si l'une
    // manque, requireAccessConfig() dans src/auth/access.ts refuse toute requête
    // avec un message qui la nomme, plutôt qu'une erreur interne opaque.
    // Domaine utilisé pour générer le Message-ID des emails envoyés (voir
    // src/api/routes.ts). Placeholder ici ; le domaine réel vit dans
    // wrangler.overrides.json (ignoré par git).
    "MAIL_DOMAIN": "example.com"
  }
}
