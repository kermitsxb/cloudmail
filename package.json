{
  "name": "cloudmail",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"pnpm wrangler dev\" \"pnpm --filter web dev\"",
    "build": "pnpm --filter web build",
    "config": "node scripts/config.mjs",
    "config:check": "node scripts/config.mjs --check",
    "deploy": "node scripts/config.mjs && pnpm build && pnpm wrangler deploy -c .wrangler/generated.jsonc",
    "migrate:remote": "node scripts/config.mjs && pnpm wrangler d1 migrations apply cloudmail --remote -c .wrangler/generated.jsonc",
    "test": "vitest run && pnpm --filter web test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.18.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "dependencies": {
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "postal-mime": "^3.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.5",
    "@cloudflare/workers-types": "^5.20260908.1",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.1"
  }
}
